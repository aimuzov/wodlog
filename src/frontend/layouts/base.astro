---
import Seo from '@aimuzov/infra-site-kit/seo.astro'
import Footer from '#frontend/components/footer.astro'
import '@aimuzov/infra-site-kit/base.css'
import '#frontend/styles/global.css'
import { site } from '#frontend/data/site.ts'
import { pageTitle } from '#frontend/lib/title.ts'

type Props = {
	/** Название страницы, к нему добавится название сайта. У главной не задаётся. */
	title?: string
	/** `meta description` и `og:description`, по умолчанию `site.description`. */
	description?: string
	/** `false` у служебных страниц вроде 404: без canonical и с запретом индексации. */
	index?: boolean
	/** Страница приложения: без подвала и до краёв экрана под вырезом. */
	app?: boolean
}

const { title, description = site.description, index = true, app = false } = Astro.props
const fullTitle = pageTitle(title)
const canonical = new URL(Astro.url.pathname, Astro.site)
---

<!doctype html>
<html lang="ru">
	<head>
		<meta charset="utf-8" />
		<meta
			name="viewport"
			content={
				app ? 'width=device-width, initial-scale=1, viewport-fit=cover' : 'width=device-width, initial-scale=1'
			}
		/>
		<meta name="theme-color" content="#0c0c0f" />
		<link rel="manifest" href="/manifest.webmanifest" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<Seo
			title={fullTitle}
			description={description}
			siteName={site.name}
			url={canonical}
			locale="ru_RU"
			type="website"
			canonical={index ? canonical : undefined}
			robots={index ? undefined : 'noindex'}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<slot name="head" />
	</head>
	<body>
		<slot />
		{!app && <Footer />}
		<script>
			import { sentry } from '#frontend/lib/sentry.ts'
			sentry()
		</script>
	</body>
</html>
